# Copia este archivo como .env.local y completa solo el modo que uses.
# Nunca subas .env.local al repositorio.

# Modelo de Gemini. Por defecto: gemini-3.8-flash.
VITE_GEMINI_MODEL=gemini-3.8-flash

# --- Modo recomendado: proxy propio (sitio publicado) ---
# La clave vive en el servidor del proxy, no en el navegador.
# Ver ai-proxy/README.md para desplegarlo.
VITE_AI_PROXY_URL=
# Opcional: debe coincidir con el secreto PROXY_TOKEN del Worker.
VITE_AI_PROXY_TOKEN=

# --- Modo directo: solo desarrollo local o uso personal ---
# ADVERTENCIA: cualquier variable VITE_ se incluye en el JavaScript publicado
# y puede leerse desde el navegador. No la uses en un sitio público.
VITE_GEMINI_API_KEY=
